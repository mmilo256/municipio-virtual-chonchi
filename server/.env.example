# Servidor
NODE_ENV=development
PORT=10000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
COOKIE_SECURE=false
SESSION_MAX_AGE_MS=900000
TRUST_PROXY=0
MAX_JSON_SIZE=1mb
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_FIELD_SIZE_MB=1
MAX_UPLOAD_FILES=10
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
LOG_LEVEL=info
PORTAL_PUBLIC_URL=http://localhost:5173
ADMIN_PUBLIC_URL=http://localhost:5174/admin

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=municipio_virtual
DB_USER=municipio_virtual
DB_PASSWORD=reemplazar
DB_SYNC=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# Correo SMTP
EMAIL=usuario@example.com
EMAIL_PASSWORD=reemplazar
SMTP_HOST=mail.municipalidadchonchi.cl
SMTP_PORT=465
SMTP_SECURE=true

# ClaveUnica / OAuth
CLIENT_ID=reemplazar
CLIENT_SECRET=reemplazar
REDIRECT_URI=http://localhost:10000/api/portal/auth/callback
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h
HOME_URL=http://localhost:5173
